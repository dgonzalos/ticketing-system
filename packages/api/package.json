{
  "name": "@ticketing/api",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/db/migrate.ts",
    "db:seed": "tsx src/infrastructure/db/seed.ts",
    "db:seed-admin": "tsx src/infrastructure/db/seed-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@fastify/cors": "^8.4.0",
    "@fastify/helmet": "^11.1.0",
    "@fastify/jwt": "^8.0.1",
    "@ticketing-system/shared": "workspace:*",
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.45.2",
    "fast-jwt": "^4.0.0",
    "fastify": "^4.24.0",
    "fastify-raw-body": "^4.3.0",
    "pg": "^8.11.0",
    "stripe": "^22.6.1",
    "zod": "^3.22.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.10.9",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}